# Reddit API Credentials
# Get these at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT="script:ssp-sniper:v1.0 (by /u/YOUR_USERNAME)"

# OpenAI or Gemini API Key (Using OpenAI format for this template)
OPENAI_API_KEY=your_openai_api_key

# Discord Webhook URL
# Create this in Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
